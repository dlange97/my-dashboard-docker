APP_ENV=dev

MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_root_password
MYSQL_USER=app
MYSQL_PASSWORD=CHANGE_ME_strong_db_password

RABBITMQ_DEFAULT_USER=mydashboard
RABBITMQ_DEFAULT_PASS=CHANGE_ME_strong_rabbitmq_password

JWT_PASSPHRASE=CHANGE_ME_strong_jwt_passphrase

AUTH_APP_SECRET=CHANGE_ME_auth_secret_32hex
DASHBOARD_APP_SECRET=CHANGE_ME_dashboard_secret_32hex
EVENTS_APP_SECRET=CHANGE_ME_events_secret_32hex
NOTIFICATION_APP_SECRET=CHANGE_ME_notification_secret_32hex
TRANSLATION_APP_SECRET=CHANGE_ME_translation_secret_32hex

INTERNAL_NOTIFICATION_TOKEN=CHANGE_ME_internal_token_32hex

# ─── Production-only overrides (optional in dev) ──────────────
# In local dev you can leave these unset — the defaults baked into
# docker-compose.yml reproduce the current behavior exactly.
# In production you MUST set APP_ENV=prod and APP_PUBLIC_URL.

# Symfony environment: dev | prod (set to prod on AWS)
# APP_ENV=prod

# Public base URL of the app. Used by auth-service to build the
# invite / password-setup links sent in e-mails. MUST be the real
# https domain in production, otherwise invite links break.
# APP_PUBLIC_URL=https://app.your-domain.com

# CORS allow-origin regex used by every backend service. The default
# already allows *.mydashboard.com. Override only if you deploy under
# a different domain. Escape dots as \. and anchor with ^ ... $.
# CORS_ALLOW_ORIGIN=^https?://([a-z0-9-]+\.)?your-domain\.com$

# ─── Notification providers (default: log = no external calls) ───
# Leave as "log" to keep current behavior (messages are logged only).
# Set to a real provider + credentials to actually send email / push.
# NOTIFICATION_EMAIL_PROVIDER=log
# NOTIFICATION_EMAIL_API_URL=
# NOTIFICATION_EMAIL_API_KEY=
# NOTIFICATION_PUSH_PROVIDER=log
# NOTIFICATION_PUSH_API_URL=
# NOTIFICATION_PUSH_API_KEY=

